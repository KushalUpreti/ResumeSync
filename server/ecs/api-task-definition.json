{
  "family": "resumesync-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::405827713989:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::405827713989:role/resumesync-api-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "405827713989.dkr.ecr.us-east-1.amazonaws.com/resumesync-server:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "command": [
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "environment": [
        {
          "name": "RESUMESYNC_ENV",
          "value": "production"
        },
        {
          "name": "RESUMESYNC_USE_AWS_SERVICES",
          "value": "true"
        },
        {
          "name": "RESUMESYNC_AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "RESUMESYNC_STORAGE_BUCKET",
          "value": "aws-resume-bucket-kushal-upreti"
        },
        {
          "name": "RESUMESYNC_QUEUE_NAME",
          "value": "resumesync-jobs"
        },
        {
          "name": "RESUMESYNC_QUEUE_URL",
          "value": "https://sqs.us-east-1.amazonaws.com/405827713989/resumesync-jobs"
        },
        {
          "name": "RESUMESYNC_COGNITO_REGION",
          "value": "us-east-1"
        },
        {
          "name": "RESUMESYNC_COGNITO_USER_POOL_ID",
          "value": "us-east-1_ZNQPnuBYg"
        },
        {
          "name": "RESUMESYNC_COGNITO_APP_CLIENT_ID",
          "value": "4t01t8aev928ju9vqaj8evl6jg"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/resumesync-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}