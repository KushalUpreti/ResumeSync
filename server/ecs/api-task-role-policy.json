{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResumeSyncApiS3Access",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::aws-resume-bucket-kushal-upreti/jobs/*",
        "arn:aws:s3:::aws-resume-bucket-kushal-upreti/temp/*",
        "arn:aws:s3:::aws-resume-bucket-kushal-upreti/users/*",
        "arn:aws:s3:::aws-resume-bucket-kushal-upreti/prompts/*"
      ]
    },
    {
      "Sid": "ResumeSyncApiSqsSend",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SendMessage"
      ],
      "Resource": "arn:aws:sqs:us-east-1:405827713989:resumesync-jobs"
    }
  ]
}
